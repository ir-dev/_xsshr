# Template for .env_secret (the real file is gitignored and never committed).
# Copy to .env_secret and fill in. data.php reads these values from environment variables
# first, then from .env_secret in its own folder or the folder above it.
# The HTML pages are static, so the Google keys are NOT injected automatically: replace the
# __GOOGLE_MAPS_API_KEY__ / __GOOGLE_GEOCODE_API_KEY__ placeholders at deploy time.

# data.php: MySQL
XSFOOD_DB_HOST=db.example.com:3306
XSFOOD_DB_USER=xsfood_user
XSFOOD_DB_PASS=change-me
XSFOOD_DB_NAME=xsfood_db

# data.php: MSG91 SMS gateway auth key
XSFOOD_MSG91_AUTHKEY=your-msg91-authkey

# index.html: Google Maps JavaScript API key (restrict it to your domain in Google Cloud)
GOOGLE_MAPS_API_KEY=your-google-maps-js-key

# index.html, _index.html, bkup_git_src_/*.html: Google Geocoding API key
GOOGLE_GEOCODE_API_KEY=your-google-geocoding-key

# bkup_git_src_/data.php: MySQL for the original (2017) code
XSFOOD_LEGACY_DB_HOST=db.example.com
XSFOOD_LEGACY_DB_USER=xsfood_user
XSFOOD_LEGACY_DB_PASS=change-me
XSFOOD_LEGACY_DB_NAME=xsfood_db
